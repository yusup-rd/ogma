generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Owner {
  id              String   @id @default(uuid()) @db.Uuid
  identityIssuer  String   @map("identity_issuer")
  identitySubject String   @map("identity_subject")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  resumes         Resume[]

  @@unique([identityIssuer, identitySubject])
  @@map("owners")
}

model Resume {
  id            String    @id @default(uuid()) @db.Uuid
  ownerId       String    @map("owner_id") @db.Uuid
  title         String
  draftRevision Int       @default(1) @map("draft_revision")
  document      Json      @db.JsonB
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt    DateTime? @map("archived_at") @db.Timestamptz(3)
  owner         Owner     @relation(fields: [ownerId], references: [id])

  @@index([ownerId, archivedAt, updatedAt])
  @@map("resumes")
}
