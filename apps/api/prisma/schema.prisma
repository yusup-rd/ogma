generator client {
  provider     = "prisma-client"
  output       = "../src/generated/database"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Owner {
  id              String         @id @default(uuid()) @db.Uuid
  identityIssuer  String         @map("identity_issuer")
  identitySubject String         @map("identity_subject")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  resumes         Resume[]
  sessions        OwnerSession[]
  libraryEntries  LibraryEntry[]

  @@unique([identityIssuer, identitySubject])
  @@map("owners")
}

model OwnerSession {
  tokenHash String   @id @map("token_hash")
  ownerId   String   @map("owner_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  owner     Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([ownerId])
  @@map("owner_sessions")
}

model SignInAttempt {
  tokenHash    String   @id @map("token_hash")
  state        String
  nonce        String
  codeVerifier String   @map("code_verifier")
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("sign_in_attempts")
}

model Resume {
  id            String             @id @default(uuid()) @db.Uuid
  ownerId       String             @map("owner_id") @db.Uuid
  title         String
  draftRevision Int                @default(1) @map("draft_revision")
  pageCount     Int?               @map("page_count")
  document      Json               @db.JsonB
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt    DateTime?          @map("archived_at") @db.Timestamptz(3)
  owner         Owner              @relation(fields: [ownerId], references: [id])
  checkpoints   ResumeCheckpoint[]

  @@index([ownerId, archivedAt, updatedAt])
  @@map("resumes")
}

model ResumeCheckpoint {
  id            String                    @id @db.Uuid
  resumeId      String                    @map("resume_id") @db.Uuid
  name          String
  resumeTitle   String                    @map("resume_title")
  draftRevision Int                       @map("draft_revision")
  document      Json                      @db.JsonB
  resolved      Json                      @db.JsonB
  layoutVersion Int                       @default(1) @map("layout_version")
  createdAt     DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  resume        Resume                    @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  restores      ResumeCheckpointRestore[]

  @@index([resumeId, createdAt])
  @@map("resume_checkpoints")
}

model ResumeCheckpointRestore {
  id            String           @id @db.Uuid
  checkpointId  String           @map("checkpoint_id") @db.Uuid
  draftRevision Int              @map("draft_revision")
  checkpoint    ResumeCheckpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)

  @@index([checkpointId])
  @@map("resume_checkpoint_restores")
}

model LibraryEntry {
  id              String                 @id @db.Uuid
  ownerId         String                 @map("owner_id") @db.Uuid
  kind            String
  currentRevision Int                    @default(1) @map("current_revision")
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt      DateTime?              @map("archived_at") @db.Timestamptz(3)
  owner           Owner                  @relation(fields: [ownerId], references: [id])
  revisions       LibraryEntryRevision[]

  @@index([ownerId, archivedAt, updatedAt])
  @@map("library_entries")
}

model LibraryEntryRevision {
  entryId   String       @map("entry_id") @db.Uuid
  revision  Int
  content   Json         @db.JsonB
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  entry     LibraryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@id([entryId, revision])
  @@map("library_entry_revisions")
}
